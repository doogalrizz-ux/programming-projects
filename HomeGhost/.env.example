# Copy this file to .env and fill in real values. Never commit .env.

# Bot token from the Discord Developer Portal (Bot tab -> Reset Token)
DISCORD_TOKEN=

# Optional: your test server's ID. When set, slash commands sync instantly
# to that one server (great for development). Leave blank to sync globally,
# which can take up to an hour to show up in Discord.
GUILD_ID=

# Channel ID where laundry reminders get posted (right-click the channel ->
# Copy Channel ID; requires Developer Mode enabled in Discord settings).
REMINDER_CHANNEL_ID=

# User ID of the person who gets pulled in once a reminder is escalated
# (e.g. a parent). Right-click their name -> Copy User ID.
ESCALATION_USER_ID=

# How often (in minutes) unacknowledged reminders repeat.
REMINDER_INTERVAL_MINUTES=5

# How many reminders go out before the escalation contact also gets pinged.
ESCALATION_THRESHOLD=3

# Path to the SQLite database file. Shared by every HomeGhost skill.
DB_PATH=homeghost.db

# --- Family scheduler ---

# Channel where scheduling commands are used and reminders get posted.
SCHEDULE_CHANNEL_ID=

# Comma-separated roster used for the "person" dropdown on schedule commands.
FAMILY_MEMBERS=Emma,Jack,Sam,Mom,Dad

# IANA timezone name. All dates/times you type into schedule commands are
# interpreted in this timezone.
TIMEZONE=America/New_York

# --- Shopping list ---

# Channel where shopping list commands are used and items get posted.
SHOPPING_CHANNEL_ID=

# Comma-separated stores. The first one is the default for /shop add
# and /shop list when no store is specified.
SHOPPING_STORES=ACME,SHOPRITE,BOOZESTORE

# --- Chore list ---

# Channel where chores get assigned/posted and /chlist is used.
CHORE_CHANNEL_ID=

# Optional subset of FAMILY_MEMBERS -- only needed so @HG can expand
# "assign X to each of the kids" / "to everyone" on its own. Leave blank
# to skip that; assigning to named people directly always works either way.
KIDS=Emma,Jack,Sam

# --- @HG natural-language assistant (optional) ---
# Leave blank to skip loading this skill entirely -- everything else in
# HomeGhost works fine without it.

# From https://aistudio.google.com/ -- Get API key.
GEMINI_API_KEY=

# Kept configurable since Google renames/retires model tiers periodically.
GEMINI_MODEL=gemini-3.1-flash-lite

# Safety cap against a bug/abuse causing runaway paid API calls.
ASSISTANT_MAX_DAILY_REQUESTS=500
