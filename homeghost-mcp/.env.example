# Copy to .env. Both have sensible defaults if you skip this entirely,
# assuming this folder sits next to HomeGhost/ like it does by default.

# Path to HomeGhost's SQLite file. Default assumes this project sits
# next to HomeGhost/ in the same parent folder.
HOMEGHOST_DB_PATH=../HomeGhost/homeghost.db

# Must match the TIMEZONE HomeGhost itself is using, so times line up.
TIMEZONE=America/New_York
